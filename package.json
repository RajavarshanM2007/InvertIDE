{
  "name": "invertide",
  "version": "1.0.0",
  "description": "InvertIDE - a reverse-engineering based coding platform for building code comprehension skills, with the Cross-Examine AI counterexample engine.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test --test-reporter=spec \"tests/*.test.js\"",
    "test:e2e": "node tests/e2e/ui.e2e.mjs",
    "reset-db": "node server/index.js --reset-only",
    "live-ai-check": "node scripts/live-ai-check.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "puppeteer-core": "^25.16.0"
  }
}
