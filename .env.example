# Copy this file to .env, then add your real Groq API key.
# Never commit .env or share the key.
PORT=3000
JWT_SECRET=replace-with-a-long-random-string
DB_FILE=./data/invertide.db
ADMIN_EMAIL=admin@invertide.local
ADMIN_PASSWORD=ChangeMe-Admin1
CHALLENGE_TIME_LIMIT_SEC=300

# Groq-hosted cloud AI (no Ollama/local model required).
AI_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_TIMEOUT_MS=30000

# Optional alternative provider if you specifically want Claude instead:
# AI_PROVIDER=claude
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5
